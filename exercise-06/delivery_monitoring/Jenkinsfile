pipeline {
    agent any

    environment {
        APP_IMAGE = 'delivery_metrics:latest'
        CONTAINER_APP = 'delivery_metrics'
        CONTAINER_PROM = 'prometheus'
        CONTAINER_GRAFANA = 'grafana'
    }

    stages {
        stage('Pre-check Docker') {
            steps {
                script {
                    try {
                        def dockerVersion = sh(script: 'docker --version', returnStdout: true).trim()
                        if (!dockerVersion) {
                            error "Docker is not installed or not in the PATH."
                        }
                        def dockerInfo = sh(script: 'docker info', returnStatus: true)
                        if (dockerInfo != 0) {
                            error "Docker daemon is not running."
                        }
                        echo "Docker is available and running: ${dockerVersion}"
                    } catch (Exception e) {
                        error "Pre-check failed: ${e.message}"
                    }
                }
            }
        }

        stage('Build Metrics Service') {
            steps {
                echo "[*] Building delivery metrics Docker image..."
                sh 'docker build -t ${APP_IMAGE} delivery_monitoring/'
            }
        }

        stage('Deploy Delivery Metrics App') {
            steps {
                script {
                    echo "[*] Starting delivery metrics container..."
                    sh '''
                        docker stop ${CONTAINER_APP} 2>/dev/null || true
                        docker rm ${CONTAINER_APP} 2>/dev/null || true
                        docker run -d -p 8000:8000 --name ${CONTAINER_APP} ${APP_IMAGE}
                    '''
                }
            }
        }

        stage('Deploy Prometheus & Alerting') {
            steps {
                script {
                    echo "[*] Starting Prometheus with alert rules..."
                    sh '''
                        docker stop ${CONTAINER_PROM} 2>/dev/null || true
                        docker rm ${CONTAINER_PROM} 2>/dev/null || true
                        docker run -d --name ${CONTAINER_PROM} -p 9090:9090 \
                            -v ${WORKSPACE}/delivery_monitoring/prometheus.yml:/etc/prometheus/prometheus.yml \
                            -v ${WORKSPACE}/delivery_monitoring/alert_rules.yml:/etc/prometheus/alert_rules.yml \
                            prom/prometheus
                    '''
                }
            }
        }

        stage('Deploy Grafana Dashboard') {
            steps {
                script {
                    echo "[*] Starting Grafana..."
                    sh '''
                        docker stop ${CONTAINER_GRAFANA} 2>/dev/null || true
                        docker rm ${CONTAINER_GRAFANA} 2>/dev/null || true
                        docker run -d --name ${CONTAINER_GRAFANA} -p 3000:3000 grafana/grafana
                    '''
                }
            }
        }

        stage('Verify Health & Metrics Endpoint') {
            steps {
                echo "[*] Validating /metrics scrape endpoint..."
                sh '''
                    sleep 5
                    curl -s http://localhost:8000/metrics | grep "total_deliveries" || true
                '''
            }
        }
    }

    post {
        always {
            echo "Pipeline run completed."
        }
        success {
            echo "All monitoring services (Delivery App, Prometheus, Grafana) deployed successfully!"
        }
        failure {
            echo "Pipeline deployment encountered an error."
        }
    }
}
